{
  "AllowedHosts": "*",

  "Firebase": {
    "CredentialsPath": "App_Data/Firebase/firebase-adminsdk.json"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Layla.Api"
    }
  },

  "Seq": {
    "Endpoint": "http://localhost:4318/v1/logs"
  }
}
